# Provedor da LLM usado em POST /predict/explain e llm/evaluation.py: "groq" (default,
# gratuito, serve Llama 3) ou "openai". Copie pra .env e preencha so a chave do
# provedor escolhido.
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys) — usado quando LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (https://platform.openai.com/api-keys) — usado quando LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
